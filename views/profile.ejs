<!DOCTYPE html>
<html lang="ca">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Perfil</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%- include('partials/nav', { user }) %>
  <main class="container">
    <h1>El meu perfil</h1>
    <section class="card">
      <dl>
        <dt>Identificador</dt><dd><%= profile.id %></dd>
        <dt>Nom d'usuari</dt><dd><%= profile.username %></dd>
        <dt>Correu electrònic</dt><dd><%= profile.email %></dd>
        <dt>Rol</dt><dd><%= profile.role %></dd>
        <dt>Registrat el</dt><dd><%= new Date(profile.createdAt).toLocaleString('ca-ES') %></dd>
      </dl>
    </section>
  </main>
</body>
</html>
